__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Case data. Only the files the code reads; ACTIVSg70k as its zip (see
# data/README.md).
/data/*
!/data/README.md
!/data/case_ACTIVSg*.m
!/data/ACTIVSg*.aux
!/data/ACTIVSg*.dyr
!/data/ACTIVSg70k.zip
/data/ACTIVSg70k.aux
/data/ACTIVSg70k*.dyr

# Study output. Only the small summary artifacts are tracked; the bulk (LP
# dumps, per-iteration solver logs) is regenerable and is not.
/results/**
!/results/.gitkeep

*.log
*.lp
*.nl
*.sol
